# ============================================================================
# COLOMBO LAW SOCIETY — STANDALONE BACKEND ENVIRONMENT (RENDER)
# ============================================================================

PORT=5000
NODE_ENV=production

# Frontend URL for CORS configuration (Allow Vercel domain & localhost)
FRONTEND_URL=https://cls.vercel.app,http://localhost:3000

# JWT Authentication Secret
JWT_SECRET=cls_hulftsdorp_supreme_court_secret_key_2026

# Supabase PostgreSQL Connection (Direct / Transaction Pooler)
# Found in: Supabase Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase API Credentials (Optional: used for Supabase Storage buckets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Text.lk SMS Gateway (Sri Lanka Bar Broadcasts)
TEXT_LK_API_TOKEN=your-text-lk-bearer-token

# SMTP Email Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@colombolawsociety.com
SMTP_PASS=your-smtp-app-password
