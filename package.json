{
  "name": "colombo-law-society-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Colombo Law Society — Official Web Application (Frontend on Vercel, Backend on Render, DB on Supabase)",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:backend": "cd backend && npm start"
  },
  "keywords": [
    "colombo-law-society",
    "nextjs",
    "express",
    "supabase",
    "render",
    "vercel"
  ],
